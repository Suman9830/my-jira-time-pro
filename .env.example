# Copy to .env.local (local) and add the same names in Vercel > Settings > Environment Variables.
# Never commit real values.

# Public URL of the app (no trailing slash). Local: http://localhost:3000  Prod: https://time.yourdomain.com
APP_URL=

# Atlassian OAuth 2.0 (3LO) app: https://developer.atlassian.com/console/myapps/
# Callback URL to register: {APP_URL}/api/auth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optional. Defaults to: read:jira-user read:jira-work write:jira-work offline_access
ATLASSIAN_SCOPES=

# Optional. If you belong to several Jira sites, set the one to use, e.g. https://yourteam.atlassian.net
JIRA_SITE_URL=
# Optional. Custom field id of "Start date" in your Jira, e.g. customfield_10015
JIRA_START_DATE_FIELD=

# Any Postgres connection string: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=
# Set to true only if your host requires SSL but the URL has no sslmode (Neon URLs already include it)
DATABASE_SSL=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
